%Upload an image
% A=imread('C:\Users\luismax\Pictures\Amphiprion_ocellaris_(Clown_anemonefish)_by_Nick_Hobgood.jpg');
% figure;
% imshow(A);
% title('Imagen Original');
% A=rgb2gray(A);A=double(A);
% n=size(A);
